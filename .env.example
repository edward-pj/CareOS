# AWS Credentials & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=     # Optional (needed if using temporary session / SSO / AWS Sandbox tokens)

# LLM Orchestrator: 'gemini' | 'bedrock' | 'mock'
LLM_MODE=mock
# Gemini configuration (when LLM_MODE=gemini)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Amazon Bedrock configuration (when LLM_MODE=bedrock)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Storage & Alerts: 'memory' | 'dynamo' | 'supabase'
STORAGE=memory
DDB_TABLE=careos
# DDB_ENDPOINT=          # Optional: e.g. http://localhost:8000 for local DynamoDB
# SNS_TOPIC_ARN=         # Optional: SNS topic ARN for alert dispatch

# Supabase configuration (when STORAGE=supabase)
# One-time setup in the Supabase SQL editor: scripts/supabase-reset-v2.sql (drops the old v1 demo tables),
# then scripts/supabase-schema.sql (re-runnable). The server will not boot on the v1 schema.
# Optional live check of the storage contract: SUPABASE_CONTRACT=1 pnpm --filter careos-server test supabase
# SUPABASE_URL=          # e.g. https://your-project.supabase.co
# SUPABASE_KEY=          # Service-role / secret key (server only; RLS blocks the anon key)

# Authentication (PRD §8.1). Comma-separated "token=household:caregiver"; tokens must be 16+ characters.
# Unset = open mode: every request is the demo household, and the server REFUSES to start unless HOST is loopback.
# Generate one with:  openssl rand -hex 24
# CAREOS_TOKENS=<token-for-sarah>=demo:sarah,<token-for-dad>=demo:dad
# CAREOS_WEB_TOKEN=      # token the Vite dev proxy attaches for the browser (one of the tokens above)

# Server Networking
PORT=8787
HOST=127.0.0.1           # the web app reaches the server through the Vite proxy on this machine
ALLOWED_ORIGIN=          # CORS is off by default (the Vite proxy is same-origin); set only for other browser tools

# --- Phase 7 (P1) ---
# Read prescription and bottle photos with Gemini (needs GEMINI_API_KEY). Set VISION=off to disable. Photos are held in memory for one read.
# VISION=off
# Alerts to other caregivers wait until morning, except lockouts, critical blocks and emergencies. Time zone is an IANA name.
# QUIET_HOURS=22:00-07:00
# CAREOS_TIMEZONE=America/Los_Angeles
# Emergency numbers: US (911) or IN (112, ambulance 108).
# CAREOS_LOCALE=US
# Where the household is (nearby hospitals). Until Amazon Location is connected the hospitals are labelled SAMPLE DATA.
# HOUSEHOLD_LAT=47.6062
# HOUSEHOLD_LNG=-122.3321
# How long a simulated Amazon order takes to arrive, in seconds (the real promise shown is "Tomorrow by 8:00 AM").
# SHOP_DEMO_SECONDS=60
