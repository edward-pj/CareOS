{
  "name": "careos-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:bedrock": "tsx scripts/smoke-bedrock.ts",
    "smoke:gemini": "tsx scripts/smoke-gemini.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1000.0",
    "@aws-sdk/client-sns": "^3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.1000.0",
    "@google/genai": "^2.30.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "open-caregiver-mcp": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
