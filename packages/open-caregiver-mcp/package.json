{
  "name": "open-caregiver-mcp",
  "version": "0.1.0",
  "description": "Deterministic pediatric dosing, interval-lock and contraindication MCP server",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "exports": {
    ".": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./http": {
      "source": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./testing": {
      "source": "./src/testing/storageContract.ts",
      "types": "./dist/testing/storageContract.d.ts",
      "default": "./dist/testing/storageContract.js"
    }
  },
  "bin": {
    "open-caregiver-mcp": "dist/bin/stdio.js",
    "open-caregiver-mcp-http": "dist/bin/http.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
